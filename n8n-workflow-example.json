{
  "name": "BHBAND Calculadora - Integração n8n",
  "description": "Exemplo de workflow n8n para integrar com API BHBAND",
  "nodes": [
    {
      "parameters": {
        "url": "https://seu-projeto.vercel.app/api/calcular-orcamento",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "bodyContent": "{\n  \"quantidade\": \"{{ $node['Qualificação'].json.quantidade }}\",\n  \"custoUnitario\": \"{{ $node['Qualificação'].json.custo }}\",\n  \"nomeProduto\": \"{{ $node['Qualificação'].json.produto }}\",\n  \"personalizacao\": \"{{ $node['Qualificação'].json.tecnica }}\",\n  \"estrategia\": \"PADRÃO\"\n}"
      },
      "id": "ec6723dd-adc6-4e81-9ecf-5eaebf72ef6c",
      "name": "Calcular Orçamento BHBAND",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [550, 300]
    },
    {
      "parameters": {
        "service": "twilio",
        "from": "+1234567890",
        "toField": "{{ $node['Qualificação'].json.cliente_whatsapp }}",
        "text": "{{ $node['Calcular Orçamento BHBAND'].json.orcamento_whatsapp }}"
      },
      "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
      "name": "Enviar WhatsApp",
      "type": "n8n-nodes-base.sms",
      "typeVersion": 1,
      "position": [850, 300]
    }
  ],
  "connections": {
    "Qualificação": {
      "main": [
        [
          {
            "node": "Calcular Orçamento BHBAND",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Calcular Orçamento BHBAND": {
      "main": [
        [
          {
            "node": "Enviar WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "notes": "1. Substitua 'seu-projeto.vercel.app' pela sua URL de deploy\n2. Configure seu service de WhatsApp (Twilio, Baileys, etc)\n3. Ajuste o node 'Qualificação' conforme sua fonte de dados (webhook, Claude, etc)",
  "settings": {}
}
